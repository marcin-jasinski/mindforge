{
  "enabledPlugins": {
    "dark-factory@dark-factory": true
  },
  "extraKnownMarketplaces": {
    "dark-factory": {
      "source": {
        "source": "github",
        "repo": "marcin-jasinski/dark-factory",
        "ref": "develop"
      }
    }
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh",
            "timeout": 900
          }
        ]
      }
    ]
  }
}
