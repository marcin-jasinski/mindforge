# MindForge Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------

# Full JDBC URL for PostgreSQL. Used by Spring Data JPA and Flyway.
DATABASE_URL=jdbc:postgresql://localhost:5432/mindforge

# PostgreSQL credentials (must match DATABASE_URL host/port/db)
DATABASE_USERNAME=mindforge
DATABASE_PASSWORD=changeme

# ---------------------------------------------------------------------------
# Neo4j (required — graph layer)
# ---------------------------------------------------------------------------

NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=changeme

# ---------------------------------------------------------------------------
# AI / LLM (required)
# ---------------------------------------------------------------------------

# API key for OpenRouter (https://openrouter.ai)
# For local dev with LM Studio, set OPENROUTER_BASE_URL=http://localhost:1234/v1
# and any non-empty string for OPENROUTER_API_KEY.
OPENROUTER_API_KEY=sk-or-changeme
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model strings routed by ModelTier — override to use different providers.
# SMALL: cheap classification tasks (relevance guard, quiz evaluation)
# LARGE: synthesis tasks (summariser, flashcard generator, concept mapper)
# VISION: image analysis
AI_MODEL_SMALL=openai/gpt-4o-mini
AI_MODEL_LARGE=openai/gpt-4o
AI_MODEL_VISION=openai/gpt-4o

# ---------------------------------------------------------------------------
# Security / JWT (required)
# ---------------------------------------------------------------------------

# Random secret used to sign JWTs. Must be at least 256 bits (32+ chars).
# Generate with: openssl rand -hex 32
JWT_SECRET=changeme_replace_with_256bit_secret

# JWT cookie lifetime in seconds (default 86400 = 24 hours)
JWT_EXPIRY_SECONDS=86400

# ---------------------------------------------------------------------------
# OAuth2 — Google (optional if using email/password only)
# ---------------------------------------------------------------------------

GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=changeme

# ---------------------------------------------------------------------------
# OAuth2 — GitHub (optional if using email/password only)
# ---------------------------------------------------------------------------

GITHUB_CLIENT_ID=changeme
GITHUB_CLIENT_SECRET=changeme
