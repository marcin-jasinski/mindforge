# MindForge Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ---------------------------------------------------------------------------
# Database (required)
# ---------------------------------------------------------------------------

# Full JDBC URL for PostgreSQL. Used by Spring Data JPA and Flyway.
DATABASE_URL=jdbc:postgresql://localhost:5432/mindforge

# PostgreSQL credentials (must match DATABASE_URL host/port/db)
DATABASE_USERNAME=mindforge
DATABASE_PASSWORD=changeme

# ---------------------------------------------------------------------------
# AI / LLM (required)
# ---------------------------------------------------------------------------

# API key for OpenRouter (https://openrouter.ai)
# For local dev with LM Studio, set OPENROUTER_BASE_URL=http://localhost:1234/v1
# and any non-empty string for OPENROUTER_API_KEY.
OPENROUTER_API_KEY=sk-or-changeme
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Model strings routed by ModelTier — override to use different providers.
# SMALL: cheap classification tasks (relevance guard, quiz evaluation)
# LARGE: synthesis tasks (summariser, flashcard generator, concept mapper)
# VISION: image analysis
AI_MODEL_SMALL=openai/gpt-4o-mini
AI_MODEL_LARGE=openai/gpt-4o
AI_MODEL_VISION=openai/gpt-4o

# Per-call timeout budget enforced by DeadlineProfile (Duration strings, e.g. 10s, 5m)
AI_DEADLINE_INTERACTIVE=10s
AI_DEADLINE_BATCH=60s
AI_DEADLINE_BACKGROUND=300s

# A run whose cost is above this many USD logs a warning (default 0.50)
AI_COST_WARNING_USD=0.50

# ---------------------------------------------------------------------------
# Security / JWT (required)
# ---------------------------------------------------------------------------

# Random secret used to sign JWTs. Must be at least 256 bits (32+ chars).
# Generate with: openssl rand -hex 32
JWT_SECRET=changeme_replace_with_256bit_secret

# JWT cookie lifetime in seconds (default 86400 = 24 hours)
JWT_EXPIRY_SECONDS=86400

# Optional — set false only for local development over plain HTTP; the session cookie is otherwise Secure
AUTH_SECURE_COOKIES=true

# Optional — sign-in and sign-up POSTs share one allowance per client address (default 10 per PT1M). The counters are
# in memory: correct only with one live instance.
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW=PT1M

# Optional — the one origin admitted cross-origin with credentials. Blank admits no origin. Set it only when the SPA is
# served from another origin than the API. One exact origin (for example https://app.example.com), never a list,
# never *.
CORS_ALLOWED_ORIGIN=

# Optional — the proxies whose X-Forwarded-For / X-Forwarded-Proto the server trusts (comma-separated CIDR list or a
# Java regex). Unset = Spring's private, loopback, link-local and CGNAT ranges. Set it to your reverse proxy's address
# when another host on a private address can reach the server.
# SERVER_TOMCAT_REMOTEIP_INTERNAL_PROXIES=10.0.0.5/32

# ---------------------------------------------------------------------------
# Dependency check (optional) — read only by mvn dependency-check:check, not by the server
# ---------------------------------------------------------------------------

# SECRET. Optional NVD API key, free from nvd.nist.gov. It makes the NVD download faster. Never commit a value.
NVD_API_KEY=

# ---------------------------------------------------------------------------
# OAuth2 — Google (optional if using email/password only)
# ---------------------------------------------------------------------------

GOOGLE_CLIENT_ID=changeme.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=changeme

# ---------------------------------------------------------------------------
# OAuth2 — GitHub (optional if using email/password only)
# ---------------------------------------------------------------------------

GITHUB_CLIENT_ID=changeme
GITHUB_CLIENT_SECRET=changeme

# ---------------------------------------------------------------------------
# Uploads (optional)
# ---------------------------------------------------------------------------

# Largest document accepted on any upload channel (DataSize, e.g. 50MB)
UPLOAD_MAX_SIZE=50MB

# ---------------------------------------------------------------------------
# Article fetch (optional) — off by default; see docs/project/deployment.md
# ---------------------------------------------------------------------------

# Fetch the web articles that new uploads link to and ingest each as an ARTICLE document
FETCH_EXTERNAL_ARTICLES=false
# Article URLs fetched per document; the remainder are skipped and logged
ARTICLES_MAX_PER_DOCUMENT=10
# Largest article response read (DataSize)
ARTICLES_MAX_BODY_SIZE=2MB
# Connect timeout, and total time per article URL across up to 5 redirects (Duration)
ARTICLES_CONNECT_TIMEOUT=5s
ARTICLES_REQUEST_TIMEOUT=15s

# ---------------------------------------------------------------------------
# Discord bot (optional) — off while DISCORD_BOT_TOKEN is blank; see docs/project/deployment.md
# ---------------------------------------------------------------------------

# SECRET. The bot token from the Discord developer portal. Blank = the bot does not start.
DISCORD_BOT_TOKEN=
# Required when the token is set: comma-separated guild ids. Empty with a token = the server does not start.
MINDFORGE_DISCORD_ALLOWED_GUILD_IDS=
# Optional: comma-separated role ids. Empty = any member of an allowed guild.
MINDFORGE_DISCORD_ALLOWED_ROLE_IDS=
# When the daily due-flashcard reminder DMs go out (Spring cron, six fields) and in which time zone
MINDFORGE_DISCORD_REMINDER_CRON="0 0 9 * * *"
MINDFORGE_DISCORD_REMINDER_ZONE=UTC
# Commands are guild-only; DMs are outbound only (reminders). Every reply is ephemeral. The bot never runs in the cli
# profile. Bot commands share RATE_LIMIT_REQUESTS / RATE_LIMIT_WINDOW (default 30 per PT1M) with the web, with a
# separate counter per Discord user. A Discord user gets a separate account (discord-<id>@users.invalid) that cannot
# see a web account's knowledge bases. Each /ask is one Query turn with no follow-up context; after a restart, run
# /quiz start again. A live test against real Discord needs a token and a test guild (not automated).

# ---------------------------------------------------------------------------
# Slack bot (optional) — off while both Slack tokens are blank; see docs/project/deployment.md
# ---------------------------------------------------------------------------

# SECRET. The bot token (xoxb-). Set it together with SLACK_APP_TOKEN: only one of the two = the server does not start.
SLACK_BOT_TOKEN=
# SECRET. The app-level token (xapp-, scope connections:write) that opens the Socket Mode connection.
SLACK_APP_TOKEN=
# Required when the tokens are set: comma-separated team (workspace) ids. Empty with the tokens = the server does not
# start. A caller is admitted only when the request's workspace and the caller's own team are both listed.
SLACK_ALLOWED_TEAM_IDS=
# Commands: /mf-ask <question>, /mf-quiz start, /mf-quiz answer <text>. Upload: send one file to the bot in a DM, with
# optional text lesson_id=<value> and new_version. Commands and uploads use the caller's only knowledge base. Command
# replies are ephemeral. The bot never runs in the cli profile and sends no reminders. Bot commands share
# RATE_LIMIT_REQUESTS / RATE_LIMIT_WINDOW with the web, with a separate counter per Slack user. A Slack user gets a
# separate account (slack-<team>-<user>@users.invalid) that cannot sign in to the web. A live test against real Slack
# needs a Slack app, both tokens and a test workspace (not automated).

# ---------------------------------------------------------------------------
# API description (optional)
# ---------------------------------------------------------------------------

# Serves /v3/api-docs and /swagger-ui.html. Off by default; turn on only to regenerate the frontend's types.
API_DOCS_ENABLED=false

# ---------------------------------------------------------------------------
# Langfuse tracing (optional) — no traces are exported unless both keys are set
# ---------------------------------------------------------------------------

LANGFUSE_HOST=https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
